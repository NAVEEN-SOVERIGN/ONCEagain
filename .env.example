# Environment Configuration for Offline OA Screening Platform

PROJECT_NAME="NER OA Screening Platform"
VERSION="1.0.0"
API_V1_STR="/api/v1"
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Database (Offline-First SQLite)
DATABASE_URL="sqlite:///./data/oa_screening.db"

# Operating Mode
OFFLINE_MODE=true
ENABLE_SIMULATION=true
DEFAULT_CAMP_LOCATION="Assam PHC Mobile Unit #3"
DEFAULT_OPERATOR="Community Health Worker"
